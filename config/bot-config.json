{
  "bot": {
    "name": "Advanced Discord Bot",
    "version": "2.0.0",
    "prefix": "!",
    "color": "#667eea"
  },
  "modules": {
    "music": {
      "enabled": true,
      "maxQueueSize": 100,
      "premiumMaxQueueSize": 500
    },
    "admin": {
      "enabled": true,
      "modLogChannel": null,
      "warningThreshold": 3
    },
    "tickets": {
      "enabled": true,
      "category": null,
      "maxOpenTickets": 5
    },
    "premium": {
      "enabled": true,
      "tiers": ["Basic", "Standard", "Premium"]
    }
  },
  "features": {
    "autoModeration": false,
    "welcomeMessages": false,
    "customCommands": false,
    "logging": true
  }
}